{
  "name": "dar-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3220 --strictPort --host 127.0.0.1",
    "build": "vite build && node tools/build-locales.mjs",
    "start": "node server/start.mjs",
    "preview": "node server/start.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/verify-browser.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "playwright": "1.65.0",
    "typescript": "6.0.3",
    "vite": "8.3.7"
  }
}
